[Unit]
Description=Раз на хвилину смикає планувальник CRM

#   sudo cp deploy/systemd/crm-scheduler.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crm-scheduler.timer

[Timer]
OnCalendar=*:0/1
AccuracySec=10s
Persistent=false

[Install]
WantedBy=timers.target
